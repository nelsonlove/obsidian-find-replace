{
  "name": "obsidian-find-replace",
  "version": "0.2.0",
  "description": "Multi-file find & replace for Obsidian with preview-and-confirm.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "node scripts/preflight.mjs",
    "lint": "eslint .",
    "version": "node version-bump.mjs"
  },
  "keywords": [
    "obsidian",
    "find",
    "replace",
    "regex",
    "search"
  ],
  "author": "Nelson Love",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.7.2",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
